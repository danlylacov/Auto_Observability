# Copy to .env and adjust. Used by users_api container.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auto_observability

JWT_SECRET=change-me-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

MAINTAINER_USERNAME=maintainer
MAINTAINER_PASSWORD=changeme

