# Локально: скопируйте в `.env` в этой папке.
# Docker Compose: используйте корневой `.env` (см. `.env.example` в корне репозитория).

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_USR=minioadmin
MINIO_PWD=minioadmin

# Локальный путь к конфигурации Prometheus на хосте (для Docker — в корневом `.env` как PROMETHEUS_CONFIG_HOST_PATH)
# PROMETHEUS_CONFIG_HOST_PATH=/absolute/path/to/prometheus_manager/app/services/prometheus
