# Скопируйте в `.env` в корне репозитория и при необходимости измените значения.
# Docker Compose подставляет переменные из `.env` в compose-файл и передаёт их в контейнеры (env_file).
# Исключение: сервис `docker_api` читает только `docker_api/.env` (см. docker-compose.yml).

# --- PostgreSQL (образ postgres + клиенты) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auto_observability
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auto_observability

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=True
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (корневые учётные для контейнера minio + ключи для клиентов S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_USR=minioadmin
MINIO_PWD=minioadmin
BUCKET_NAME=my-test-bucket

# --- JWT / первый пользователь (users_api + api_agregator; секреты должны совпадать) ---
JWT_SECRET=change-me-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
MAINTAINER_USERNAME=maintainer
MAINTAINER_PASSWORD=changeme

# --- Внешние URL микросервисов (внутренняя сеть Docker) ---
PROMETHEUS_GENERATION_URL=http://prometheus_generation:8000
DOCKER_API_URL=http://docker_api:8000
PROMETHEUS_MANAGER_URL=http://prometheus_manager:8000
GRAFANA_MANAGER_URL=http://grafana_manager:8000
DOCKER_CLASSIFICATION_API_URL=http://docker_classification:8000
GRAFANA_GENERATION_URL=http://grafana_generation:8000

# --- Grafana (хост или host.docker.internal с точки зрения контейнера grafana_generation) ---
GRAFANA_URL=http://host.docker.internal:3052
GRAFANA_USER=admin
GRAFANA_PASSWORD=Passw0rd
DEFAULT_PROMETHEUS_DS_UID=prometheus

# --- Prometheus Manager: абсолютный путь на хосте с Docker к каталогу конфигов Prometheus ---
PROMETHEUS_CONFIG_HOST_PATH=/absolute/path/to/repo/prometheus_manager/app/services/prometheus

# --- Порты и фронтенд (сборка) ---
USERS_API_HOST_PORT=8082
GRAFANA_GENERATION_HOST_PORT=18010
VITE_GRAFANA_EXTERNAL_URL=http://localhost:3052

# --- Прочее ---
DEBUG=False
